digraph S {
  rankdir=TB; nodesep=0.5; fontname="Helvetica"; node [fontname="Helvetica", fontsize=10, shape=box, style="rounded,filled", fillcolor="#ffffff"];
  edge [fontname="Helvetica", fontsize=8];
  p [label="Producer\n(t0 = produced_at_ms)"];
  k1 [label="Kafka\necom.events", fillcolor="#fff3e0"];
  subgraph cluster_spark { label="Spark Structured Streaming (trigger 5s)"; style="rounded,dashed";
    qa [label="[A] events_to_lake\nforeachBatch: append Parquet\nđo latency = t_ghi_xong − t0"];
    qb [label="[B] kpi_windows\nwithWatermark(2 min)\nwindow(5 min), outputMode=append"]; }
  lake [label="MinIO\nbronze_stream/events", fillcolor="#e8f5e9"];
  k2 [label="Kafka\necom.kpi", fillcolor="#fff3e0"];
  re [label="Alert engine\nRuleEngine.evaluate()"];
  out [label="alerts.jsonl · Telegram\nWebhook · ecom.alerts", fillcolor="#ffebee"];
  ck [label="Checkpoint (S3A)\noffset + state store", shape=cylinder, fillcolor="#f5f5f5"];
  p -> k1; k1 -> qa; k1 -> qb; qa -> lake; qb -> k2 [label="1 bản tin / cửa sổ đã chốt"]; k2 -> re -> out;
  qa -> ck [style=dotted, arrowhead=none]; qb -> ck [style=dotted, arrowhead=none];
}
